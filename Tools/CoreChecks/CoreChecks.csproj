<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Packages/com.nplaudio.spatialfabric/Runtime/Osc/*.cs" Link="Osc/%(Filename)%(Extension)" />
    <Compile Include="../../Packages/com.nplaudio.spatialfabric/Runtime/Playback/WavDecoder.cs" Link="Audio/WavDecoder.cs" />
    <Compile Include="../../Packages/com.nplaudio.spatialfabric/Runtime/Playback/PlaybackObservation.cs" Link="Audio/PlaybackObservation.cs" />
    <Compile Include="../../Packages/com.nplaudio.spatialfabric/Runtime/Protocols/CustomProtocol.cs" Link="Protocols/CustomProtocol.cs" />
    <Compile Include="../../Packages/com.nplaudio.spatialfabric/Runtime/Protocols/RoutingCsvCodec.cs" Link="Protocols/RoutingCsvCodec.cs" />
    <Compile Include="../../Packages/com.nplaudio.spatialfabric/Runtime/Protocols/ContractJson.cs" Link="Protocols/ContractJson.cs" />
    <Compile Include="../../Packages/com.nplaudio.spatialfabric/Runtime/Paths/Path*.cs" Link="Paths/%(Filename)%(Extension)" />
    <Compile Include="../../Packages/com.nplaudio.spatialfabric/Editor/ContextExportCore.cs" Link="Editor/ContextExportCore.cs" />
  </ItemGroup>
</Project>
